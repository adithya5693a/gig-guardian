# Optional hackathon/demo key. Never commit your real .env file.
# Vite exposes VITE_* values to the browser, so use a backend proxy for production.
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.0-flash
VITE_LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions
VITE_LM_STUDIO_MODEL=Qwen2.5-Coder-7B-Instruct-4bit
